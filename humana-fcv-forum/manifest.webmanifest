{
  "name": "Humana: FCV Forum",
  "short_name": "FCV Forum",
  "description": "Widget prototype, full screen",
  "start_url": "./?full",
  "scope": "./",
  "id": "/humana-fcv-forum/",
  "display": "fullscreen",
  "display_override": [
    "fullscreen",
    "standalone"
  ],
  "orientation": "portrait",
  "background_color": "#f9f9fb",
  "theme_color": "#4754eb",
  "icons": [
    {
      "src": "assets/app-icon/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "assets/app-icon/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "assets/app-icon/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}